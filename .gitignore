# Public allowlist: this repository publishes only the website, README, release notes,
# licence/credits, issue templates and the Byobu data workflow. Everything else
# (source, build scripts, tooling, internal docs) stays out of Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md

!/docs/
/docs/*
!/docs/index.html
!/docs/.nojekyll
!/docs/assets/

!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/byobu-resources.yml

!/scripts/
/scripts/*
!/scripts/byobu-assemble.mjs

# Never commit binaries or secrets (the installer is attached to GitHub releases instead)
*.exe
*.env
.env*
*.pfx
*.pem
*.key

# Rust build artifacts
/target/

# Distribution & packaging
dist/
/installer/
*.zip

# Local runtime data (root only, so source folders named "data" are never hidden)
/data/
/user_data/
/profile/
*.log

# Windows build artifacts & binaries
*.pdb
*.obj
*.exe
*.dll
*.res
*.lib
*.msi
*.ilk
*.exp

# Generated by scripts/build-installer.ps1 (the browser embedded in the installer)
/crates/installer/assets/

# Rust leftovers
*.rs.bk
/target-*/

# IDE, OS & editor files
.idea/
.vscode/
.vs/
*.user
*.suo
*.swp
*.bak
*.orig
*.rej
*.tmp
*~
Thumbs.db
Desktop.ini
.DS_Store

# AI assistant and tool working files
.claude/
.cursor/
.aider*

# Secrets and signing material (never commit these)
.env
.env.*
*.pfx
*.p12
*.pem
*.key
*.snk

